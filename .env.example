# Backend API Base URL
# In local development, defaults to http://localhost:3001/api
# In production on Vercel, defaults to same-origin /api if rewrites/proxy is used
VITE_API_URL="http://localhost:3001/api"

# Firebase Authentication (Web Client)
# Obtain these from Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
