# Database connection string (SQLite dev file or PostgreSQL URL)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js configuration
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="skillimprove-dev-jwt-secret-replace-with-openssl-rand-hex-32"

# Firebase Admin SDK Configuration (Server-Side Token Verification)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Optional: Google Gemini API key for AI route handlers
GEMINI_API_KEY=""
